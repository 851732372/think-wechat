{
    "name": "851732372/think-wechat",
    "description": "ThinkPHP 微信开发工具包（小程序、支付、公众号）",
    "type": "library",
    "version": "1.0.0",
    "keywords": ["thinkphp", "wechat", "miniprogram", "payment", "official-account", "微信支付", "微信小程序"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ginger",
            "email": "851732372@qq.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-openssl": "*",
        "topthink/framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Ginger\\ThinkWeChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ginger\\ThinkWeChat\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "extra": {
        "think": {
            "config": {
                "wechat": "src/config.php"
            }
        }
    },
    "minimum-stability": "stable"
}
